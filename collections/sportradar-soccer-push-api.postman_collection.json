      "name": "Soccer Push",
      "description": {
        "content": "Soccer Push Feeds deliver real-time match events and statistics over HTTP chunked streaming for 500+ competitions worldwide.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "cca0a429-2e25-4cfb-b411-d6d54a23da15",
          "name": "Subscribe to Soccer Push Events",
          "request": {
            "name": "Subscribe to Soccer Push Events",
            "description": {
              "content": "Opens a long-lived HTTP chunked connection that streams real-time match events across Sportradar's soccer coverage. Heartbeat messages are sent every five seconds when no new events are available. Use the optional sport_event_id filter to limit the stream to a single match.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "soccer",
                ":access_level",
                ":version",
                "stream",
                "events",
                "subscribe"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "sport_event_id",
                  "value": "<string>",
                  "description": "Limit the stream to a specific sport event identifier."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>",
                  "description": "Response format. Defaults to JSON."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "access_level",
                  "description": "(Required) Sportradar access level for the requested package. Trial accounts use 'trial'; production customers use 'production'."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "version",
                  "description": "(Required) Sportradar Soccer API version (for example, v4)."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
