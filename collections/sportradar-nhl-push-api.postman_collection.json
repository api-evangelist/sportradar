      "id": "6d5a9be1-190b-49e3-a7b3-9198c12e5fb4",
      "name": "NHL Push",
      "description": {
        "content": "NHL Push Feeds deliver real-time game events, statistics, and enriched clock data over HTTP chunked streaming.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "b548e146-8885-41f9-a59d-df1e6dca56f2",
          "name": "Subscribe to NHL Push Events",
          "request": {
            "name": "Subscribe to NHL Push Events",
            "description": {
              "content": "Opens a long-lived HTTP chunked connection that streams real-time NHL game event details. Heartbeat messages are sent every five seconds when no new events are available.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "nhl",
                ":access_level",
                "stream",
                ":language_code",
                "events",
                "subscribe"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "match",
                  "value": "<string>",
                  "description": "Optional filter that restricts the stream to a single game. Provide the fully qualified Sportradar match identifier (for example, sd:match:b9cf745b-36a1-404e-8159-78d719742a6b)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "access_level",
                  "description": "(Required) Sportradar access level for the requested package. Trial accounts use 'trial'; production customers use 'production'."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "language_code",
                  "description": "(Required) Two-letter language code controlling localized text in the feed (for example, 'en' for English)."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "e9db4455-5ec8-438c-bd6d-ca0e2651473c",
              "name": "Successful subscription. The server returns an open HTTP connection with Transfer-Encoding chunked and continuously emits JSON messages. Heartbeat messages are emitted every five seconds when no other content is available.",
              "originalRequest": {
                "url": {
                  "path": [
                    "nhl",
                    ":access_level",
                    "stream",
                    ":language_code",
