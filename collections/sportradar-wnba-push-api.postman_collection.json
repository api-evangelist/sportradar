  "item": [
    {
      "id": "8dec6ddb-0126-4531-b2e8-9c3ab54f3c82",
      "name": "WNBA Push",
      "description": {
        "content": "WNBA Push Feeds deliver real-time game events, statistics, and clock updates over HTTP chunked streaming.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "349cd698-ef54-40ac-8de0-60300d5159d2",
          "name": "Subscribe to WNBA Push Events",
          "request": {
            "name": "Subscribe to WNBA Push Events",
            "description": {
              "content": "Opens a long-lived HTTP chunked connection that streams real-time WNBA game events. Heartbeat messages are sent every five seconds when no new events are available. Use the optional match filter to limit the stream to a single game.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "wnba",
                ":access_level",
                "stream",
                "events",
                "subscribe"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "match",
                  "value": "<string>",
                  "description": "Optional filter that restricts the stream to a single game. Provide the fully qualified Sportradar match identifier (for example, sd:match:b9cf745b-36a1-404e-8159-78d719742a6b)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "access_level",
                  "description": "(Required) Sportradar access level for the requested package. Trial accounts use 'trial'; production customers use 'production'."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "c096f0cb-312e-49f5-a201-5b65fd78893d",
              "name": "Successful subscription. The server returns an open HTTP connection with Transfer-Encoding chunked and continuously emits JSON messages. Heartbeat messages are emitted every five seconds when no other content is available.",
              "originalRequest": {
                "url": {
                  "path": [
                    "wnba",
                    ":access_level",
                    "stream",
                    "events",
                    "subscribe"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "match",
                      "value": "<string>"
                    }
                  ],
                  "variable": [
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<string>",
                      "key": "access_level",
                      "description": "(Required) Sportradar access level for the requested package. Trial accounts use 'trial'; production customers use 'production'."
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "x-api-key",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
