{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sportradar Push Feeds Competitors Schedules API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Schedules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get NBA Daily Schedule",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sportradar.com/nba/trial/v8/en/games/:date/schedule.json",
            "params": [
              {
                "name": "date",
                "value": "",
                "type": "path",
                "description": "The date in YYYY/MM/DD format."
              },
              {
                "name": "api_key",
                "value": "",
                "type": "query",
                "description": "Your Sportradar API key."
              }
            ]
          },
          "docs": "Returns the schedule of NBA games for a specific date, including game status, team matchups, venue information, and broadcast details."
        }
      ]
    }
  ],
  "bundled": true
}